{
	"name": "df_day50_covid",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_adls_raw_covid_csv",
						"type": "DatasetReference"
					},
					"name": "srcCovid"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "selectCovid"
				},
				{
					"name": "castCovid"
				}
			],
			"scriptLines": [
				"parameters{",
				"     p_runDate as string",
				"}",
				"source(output(",
				"          country as string,",
				"          date as date,",
				"          total_cases as integer,",
				"          new_cases as short,",
				"          new_cases_smoothed as double,",
				"          total_cases_per_million as double,",
				"          new_cases_per_million as double,",
				"          new_cases_smoothed_per_million as double,",
				"          total_deaths as short,",
				"          new_deaths as short,",
				"          new_deaths_smoothed as double,",
				"          total_deaths_per_million as double,",
				"          new_deaths_per_million as double,",
				"          new_deaths_smoothed_per_million as double,",
				"          excess_mortality as string,",
				"          excess_mortality_cumulative as string,",
				"          excess_mortality_cumulative_absolute as string,",
				"          excess_mortality_cumulative_per_million as string,",
				"          hosp_patients as string,",
				"          hosp_patients_per_million as string,",
				"          weekly_hosp_admissions as string,",
				"          weekly_hosp_admissions_per_million as string,",
				"          icu_patients as string,",
				"          icu_patients_per_million as string,",
				"          weekly_icu_admissions as string,",
				"          weekly_icu_admissions_per_million as string,",
				"          stringency_index as double,",
				"          reproduction_rate as double,",
				"          total_tests as integer,",
				"          new_tests as string,",
				"          total_tests_per_thousand as double,",
				"          new_tests_per_thousand as string,",
				"          new_tests_smoothed as short,",
				"          new_tests_smoothed_per_thousand as double,",
				"          positive_rate as double,",
				"          tests_per_case as double,",
				"          total_vaccinations as double,",
				"          people_vaccinated as double,",
				"          people_fully_vaccinated as double,",
				"          total_boosters as double,",
				"          new_vaccinations as double,",
				"          new_vaccinations_smoothed as double,",
				"          total_vaccinations_per_hundred as double,",
				"          people_vaccinated_per_hundred as double,",
				"          people_fully_vaccinated_per_hundred as double,",
				"          total_boosters_per_hundred as double,",
				"          new_vaccinations_smoothed_per_million as double,",
				"          new_people_vaccinated_smoothed as double,",
				"          new_people_vaccinated_smoothed_per_hundred as double,",
				"          code as string,",
				"          continent as string,",
				"          population as integer,",
				"          population_density as double,",
				"          median_age as double,",
				"          life_expectancy as double,",
				"          gdp_per_capita as double,",
				"          extreme_poverty as string,",
				"          diabetes_prevalence as double,",
				"          handwashing_facilities as double,",
				"          hospital_beds_per_thousand as double,",
				"          human_development_index as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcCovid",
				"srcCovid select(mapColumn(",
				"          date,",
				"          country,",
				"          new_cases",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectCovid",
				"selectCovid derive(date = date,",
				"          new_cases = toDouble(new_cases)) ~> castCovid"
			]
		}
	}
}