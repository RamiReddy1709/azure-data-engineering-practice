{
	"name": "pl_day50_ingest_http",
	"properties": {
		"activities": [
			{
				"name": "switch_source",
				"type": "Switch",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@pipeline().parameters.p_source",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "weather",
							"activities": [
								{
									"name": "copy_weather_to_raw",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "BinarySource",
											"storeSettings": {
												"type": "HttpReadSettings",
												"requestMethod": "GET"
											},
											"formatSettings": {
												"type": "BinaryReadSettings"
											}
										},
										"sink": {
											"type": "BinarySink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "ds_http_weather_binary_day50",
											"type": "DatasetReference",
											"parameters": {
												"relativeUrl": {
													"value": "@pipeline().parameters.p_relativeUrl",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_adls_binary_day50",
											"type": "DatasetReference",
											"parameters": {
												"Filesystem": "raw",
												"directory": {
													"value": "@concat(pipeline().parameters.p_targetFolder, '/ingest_date=', pipeline().parameters.p_runDate)",
													"type": "Expression"
												},
												"fileName": "weather.json"
											}
										}
									]
								}
							]
						},
						{
							"value": "covid",
							"activities": [
								{
									"name": "copy_covid_to_raw",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "BinarySource",
											"storeSettings": {
												"type": "HttpReadSettings",
												"requestMethod": "GET"
											},
											"formatSettings": {
												"type": "BinaryReadSettings"
											}
										},
										"sink": {
											"type": "BinarySink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "ds_http_covid_binary_day50",
											"type": "DatasetReference",
											"parameters": {
												"relativeUrl": {
													"value": "@pipeline().parameters.p_relativeUrl",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_adls_binary_day50",
											"type": "DatasetReference",
											"parameters": {
												"Filesystem": "raw",
												"directory": {
													"value": "@concat(pipeline().parameters.p_targetFolder, '/ingest_date=', pipeline().parameters.p_runDate)",
													"type": "Expression"
												},
												"fileName": "weather.json"
											}
										}
									]
								}
							]
						}
					],
					"defaultActivities": [
						{
							"name": "fail_unknown_source",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('Unsupported p_source: ', pipeline().parameters.p_source, '. Expected weather or covid.')",
									"type": "Expression"
								},
								"errorCode": "UNKNOWN_SOURCE"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_source": {
				"type": "string",
				"defaultValue": "covid"
			},
			"p_relativeUrl": {
				"type": "string",
				"defaultValue": "owid/covid-19-data/master/public/data/owid-covid-data.csv"
			},
			"p_targetFolder": {
				"type": "string",
				"defaultValue": "covid"
			},
			"p_fileName": {
				"type": "string",
				"defaultValue": "owid-covid-data.csv"
			},
			"p_runDate": {
				"type": "string",
				"defaultValue": "2026-10-15"
			}
		},
		"annotations": []
	}
}