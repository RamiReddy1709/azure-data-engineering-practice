{
	"name": "pl_day50_orchestrate",
	"properties": {
		"activities": [
			{
				"name": "lookup_sources",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_day50_sources_json",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "foreach_sources",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "lookup_sources",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('lookup_sources').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "if_source_enabled",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(item().Enabled, true)",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "execute_ingest_http",
										"type": "ExecutePipeline",
										"dependsOn": [],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "pl_day50_ingest_http",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"p_source": {
													"value": "@item().source",
													"type": "Expression"
												},
												"p_relativeUrl": {
													"value": "@item().relativeUrl",
													"type": "Expression"
												},
												"p_targetFolder": {
													"value": "@item().targetFolder",
													"type": "Expression"
												},
												"p_fileName": {
													"value": "@item().fileName",
													"type": "Expression"
												},
												"p_runDate": {
													"value": "@pipeline().parameters.p_runDate",
													"type": "Expression"
												}
											}
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "CheckOrders",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "foreach_sources",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_orders_json",
						"type": "DatasetReference"
					},
					"fieldList": [
						"exists"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "JsonReadSettings"
					}
				}
			},
			{
				"name": "CheckCustomers",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "CheckOrders",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_customers_json",
						"type": "DatasetReference"
					},
					"fieldList": [
						"exists"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "JsonReadSettings"
					}
				}
			},
			{
				"name": "if_order_inputs_exist",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "CheckCustomers",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(activity('CheckOrders').output.exists, activity('CheckCustomers').output.exists)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "fail_missing_order_inputs",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "orders.json or customers.json is missing",
								"errorCode": "MISSING_ORDER_INPUT"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_runDate": {
				"type": "string",
				"defaultValue": "2026-10-15"
			}
		},
		"annotations": []
	}
}