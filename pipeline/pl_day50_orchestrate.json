{
	"name": "pl_day50_orchestrate",
	"properties": {
		"activities": [
			{
				"name": "lookup_sources",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_day50_sources_json",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "foreach_sources",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "lookup_sources",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('lookup_sources').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "execute_ingest_http",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_day50_ingest_http",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"p_source": {
										"value": "@item().source",
										"type": "Expression"
									},
									"p_relativeUrl": {
										"value": "@item().relativeUrl",
										"type": "Expression"
									},
									"p_targetFolder": {
										"value": "@item().targetFolder",
										"type": "Expression"
									},
									"p_fileName": {
										"value": "@item().fileName",
										"type": "Expression"
									},
									"p_runDate": {
										"value": "@formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd')",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}