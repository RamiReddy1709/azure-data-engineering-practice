{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-de-roadmap-dvrr26"
		},
		"ls_adls_stderoadmapdvrr26_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_stderoadmapdvrr26'"
		},
		"ls_adls_stderoadmapdvrr26_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stderoadmapdvrr26.dfs.core.windows.net/"
		},
		"ls_keyvault_de_roadmap_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-de-roadmap-dvrr26.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-de-roadmap-dvrr26_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_stderoadmapdvrr26_accountKey": {
						"value": "[parameters('ls_adls_stderoadmapdvrr26_accountKey')]"
					},
					"ls_adls_stderoadmapdvrr26_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_stderoadmapdvrr26_properties_typeProperties_url')]"
					},
					"ls_keyvault_de_roadmap_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_keyvault_de_roadmap_properties_typeProperties_baseUrl')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}